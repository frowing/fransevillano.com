---
// The thing a visitor actually uses: the code (highlighted, with "copiar") and/or the invitation link.
import type { Codigo } from '../lib/codigos';

interface Props {
  codigo: Codigo;
  compact?: boolean;
}

const { codigo, compact = false } = Astro.props;
const { code, link, name } = codigo.data;
---

<p class:list={['action', { compact }]}>
  {code && <code>{code}</code>}
  <span class="buttons">
    {
      code && (
        <>
          <span class="sep" aria-hidden="true">·</span>
          <button type="button" class="copy" data-code={code}>
            copiar
          </button>
        </>
      )
    }
    {
      link && (
        <>
          {code && <span class="sep" aria-hidden="true">·</span>}
          <a class="link" href={link} rel="sponsored nofollow noopener" target="_blank">
            {code ? 'abrir enlace' : `darme de alta en ${name}`}
          </a>
        </>
      )
    }
  </span>
</p>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.copy').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.code ?? '');
        button.textContent = 'copiado';
      } catch {
        button.textContent = 'cópialo a mano';
      }
    });
  });
</script>

<style>
  .action {
    --marker: #fff09a;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.5rem;
    margin: 1.5rem 0;
  }

  @media (prefers-color-scheme: dark) {
    .action {
      --marker: rgba(255, 224, 70, 0.3);
    }
  }

  .action.compact {
    margin: 0.25rem 0 0;
  }

  code {
    padding: 0 0.25rem;
    background: linear-gradient(transparent 45%, var(--marker) 45%);
    color: var(--heading);
    font-size: 1.3rem;
    overflow-wrap: anywhere;
  }

  .compact code {
    font-size: 1.05rem;
  }

  .buttons {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .sep {
    color: var(--muted);
  }

  .copy,
  .link {
    min-height: 44px;
    padding: 0 0.15rem;
    border: 0;
    background: none;
    color: var(--text);
    font-family: inherit;
    font-size: 1rem;
    line-height: 44px;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .copy:hover,
  .link:hover {
    color: var(--heading);
  }
</style>

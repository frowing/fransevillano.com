---
import { render } from 'astro:content';
import { postPath, formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  // On the homepage the title links to the post; on the post page it is the page heading
  linkTitle?: boolean;
}

const { post, linkTitle = false } = Astro.props;
const { Content } = await render(post);
---

<article>
  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  {
    linkTitle ? (
      <h2 class="title">
        <a href={postPath(post)}>{post.data.title}</a>
      </h2>
    ) : (
      <h1 class="title">{post.data.title}</h1>
    )
  }
  <div class="content">
    <Content />
  </div>
</article>

<style>
  article + :global(article) {
    margin-top: 7rem;
  }

  time {
    display: block;
    text-align: center;
    text-transform: uppercase;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .title {
    margin: 0.5rem 0 2.5rem;
    text-align: center;
    font-size: clamp(2.25rem, 7vw, 4rem);
    line-height: 1.25;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
  }

  .content :global(h2) {
    font-size: 1.6rem;
    margin-top: 2.5rem;
  }

  .content :global(h3),
  .content :global(h4),
  .content :global(h5) {
    font-size: 1.2rem;
    margin-top: 2rem;
  }

  .content :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    background: color-mix(in srgb, var(--text) 6%, var(--bg));
    font-size: 0.9rem;
  }

  .content :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1.25rem;
    color: var(--muted);
  }
</style>

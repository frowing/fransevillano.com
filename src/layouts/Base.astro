---
interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Fran Sevillano';
const { title, description = 'Writing about product management, health and habits.' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
  </head>
  <body>
    <header>
      <a href="/" class="site-name">{siteName}</a>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf8;
    --text: #1f1e1c;
    --muted: #6b6862;
    --accent: #2f5bd3;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #161615;
      --text: #ecebe8;
      --muted: #9b988f;
      --accent: #8aa8ff;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0 auto;
    max-width: 40rem;
    padding: 3rem 1rem 4rem;
    background: var(--bg);
    color: var(--text);
    font: 1.0625rem/1.7 system-ui, -apple-system, 'Segoe UI', sans-serif;
  }

  a {
    color: var(--accent);
    text-underline-offset: 0.2em;
  }

  /* Emphasis reads as weight rather than slant */
  em,
  i,
  cite {
    font-style: normal;
    font-weight: 600;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    line-height: 1.3;
    font-weight: 650;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  header {
    margin-bottom: 3.5rem;
  }

  .site-name {
    color: var(--text);
    font-weight: 650;
    text-decoration: none;
  }

  footer {
    margin-top: 5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  footer a {
    color: var(--muted);
  }

  .muted {
    color: var(--muted);
  }
</style>

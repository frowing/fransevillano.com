---
interface Props {
  title?: string;
  description?: string;
}

const siteName = 'Fran Sevillano';
const { title, description = 'Writing about product management, health and habits.' } = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const canonical = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/images/face.jpg" />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/face.jpg', Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    {
      !isHome && (
        <header class="site-header">
          <a href="/" aria-label="Fran Sevillano, home">
            <img src="/images/face.jpg" alt="" width="56" height="56" class="avatar" />
          </a>
        </header>
      )
    }
    <main>
      <slot />
    </main>
    <footer>
      <a href="/rss.xml">RSS</a>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --text: #404040;
    --heading: #000000;
    --muted: #707070;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141414;
      --text: #d4d4d4;
      --heading: #ffffff;
      --muted: #9a9a9a;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0 auto;
    max-width: 42rem;
    padding: 3rem 1rem 4rem;
    background: var(--bg);
    color: var(--text);
    font: 400 1.125rem/1.8 'Source Sans 3', 'Source Sans Pro', system-ui, sans-serif;
  }

  a {
    color: var(--heading);
    text-underline-offset: 0.2em;
  }

  /* Emphasis reads as weight rather than slant */
  em,
  i,
  cite {
    font-style: normal;
    font-weight: 600;
  }

  h1,
  h2,
  h3,
  h4,
  h5 {
    color: var(--heading);
    line-height: 1.3;
    font-weight: 700;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .avatar {
    display: block;
    border-radius: 50%;
  }

  .site-header {
    display: flex;
    justify-content: center;
    margin-bottom: 3rem;
  }

  footer {
    margin-top: 6rem;
    text-align: center;
    font-size: 0.9rem;
  }

  footer a {
    color: var(--muted);
  }
</style>

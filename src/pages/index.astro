---
import Base from '../layouts/Base.astro';
import PostBody from '../components/PostBody.astro';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<Base>
  <section class="intro">
    <img src="/images/face.jpg" alt="Fran Sevillano" width="104" height="104" class="avatar" />
    <!-- prettier-ignore -->
    <p>👋 My name is Fran and I make <a href="https://www.lonelyplanet.com/guides">travel apps</a> for a living, but I'm interested in many more things. You can follow me on <a href="https://twitter.com/fran__sevillano">Twitter</a>, <a href="https://www.instagram.com/fran__sevillano/">Instagram</a>, and <a href="https://medium.com/@fransevillano">Medium</a>.</p>
  </section>

  {posts.map((post) => <PostBody post={post} linkTitle />)}
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 6rem;
  }

  .intro p {
    max-width: 30rem;
    margin: 1.5rem 0 0;
    font-size: 1rem;
    line-height: 1.7;
  }
</style>

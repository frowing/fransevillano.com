---
import Base from '../../layouts/Base.astro';
import CodigosFooter from '../../components/CodigosFooter.astro';
import CodigoAction from '../../components/CodigoAction.astro';
import { getCodigos, codigoPath, fechaLarga, isDraft } from '../../lib/codigos';

const codigos = await getCodigos();

// "Coinbase, MyInvestor y Octopus Energy": the app names make the list findable by name
const names = codigos.map((c) => c.data.name);
const nameList = names.length > 1 ? `${names.slice(0, -1).join(', ')} y ${names.at(-1)}` : (names[0] ?? '');
const title = nameList ? `Códigos amigo de ${nameList}` : 'Mis códigos amigo';
const description = nameList
  ? `Códigos amigo de ${nameList}, revisados a mano: qué consigues tú, las condiciones y la fecha de la última revisión.`
  : 'Mis códigos amigo y enlaces de invitación, revisados a mano.';
---

<Base lang="es" hideHeader title={title} description={description}>
  <section class="intro">
    <a href="/" aria-label="Fran Sevillano, inicio">
      <img src="/images/face.jpg" alt="Fran Sevillano" width="104" height="104" class="avatar" />
    </a>
    <h1>Mis códigos amigo</h1>
    <p>
      👋 Hola, soy Fran. Estos son los códigos amigo de servicios que uso yo. Si te das de alta con uno de ellos, tú
      consigues un descuento o un regalo, y yo también. Reviso cada código a mano y en cada página pone cuándo lo
      comprobé por última vez.
    </p>
  </section>

  {
    codigos.length === 0 ? (
      <p class="empty">Muy pronto.</p>
    ) : (
      <ul class="list">
        {codigos.map((c) => (
          <li>
            <h2 class="name">{c.data.name}</h2>
            <p class="headline">{c.data.headline}</p>
            <CodigoAction codigo={c} compact />
            <p class="meta">
              {c.data.category} · revisado el {fechaLarga(c.data.verified)} ·{' '}
              <a href={codigoPath(c)}>condiciones</a>
              {isDraft(c) && <span class="draft">borrador</span>}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  <CodigosFooter slot="footer" />
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 4rem;
  }

  .intro h1 {
    margin: 1.5rem 0 0.5rem;
    font-size: clamp(2.25rem, 7vw, 3.25rem);
  }

  .intro p {
    max-width: 32rem;
    margin: 0.5rem 0 0;
    font-size: 1rem;
    line-height: 1.7;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid color-mix(in srgb, var(--text) 15%, var(--bg));
  }

  .list li {
    padding: 1.75rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--text) 15%, var(--bg));
  }

  .name {
    margin: 0;
    color: var(--heading);
    font-size: 1.35rem;
    line-height: 1.3;
  }

  .headline {
    margin: 0;
  }

  .meta {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .meta a {
    color: inherit;
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0 0.4rem;
    border: 1px dashed var(--muted);
    border-radius: 4px;
    font-size: 0.8rem;
  }

  .empty {
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .empty {
    text-align: center;
  }
</style>

---
import Base from '../../layouts/Base.astro';
import CodigosFooter from '../../components/CodigosFooter.astro';
import CodigoAction from '../../components/CodigoAction.astro';
import { getCodigos, codigoPath, fechaLarga, isDraft, blurbHtml, ultimaRevision } from '../../lib/codigos';

const codigos = await getCodigos();

// "Coinbase, MyInvestor y Octopus Energy": the app names make the list findable by name
const names = codigos.map((c) => c.data.name);
const nameList = names.length > 1 ? `${names.slice(0, -1).join(', ')} y ${names.at(-1)}` : (names[0] ?? '');
const title = nameList ? `Códigos amigo de ${nameList}` : 'Mis códigos amigo';
const description = nameList
  ? `Códigos amigo de ${nameList}, revisados a mano: qué consigues tú, las condiciones y la fecha de la última revisión.`
  : 'Mis códigos amigo y enlaces de invitación, revisados a mano.';
---

<Base lang="es" hideHeader title={title} description={description}>
  <section class="intro">
    <a href="/" aria-label="Fran Sevillano, inicio">
      <img src="/images/face.jpg" alt="Fran Sevillano" width="76" height="76" class="avatar" />
    </a>
    <h1>Hola, soy Fran</h1>
    <p>
      Estos son mis códigos amigo de cosas que uso.
    </p>
  </section>

  {
    codigos.length === 0 ? (
      <p class="empty">Muy pronto.</p>
    ) : (
      <>
        {codigos.map((c) => (
          <section class="codigo">
            <h2>
              <a href={codigoPath(c)}>{c.data.name}</a>
              {isDraft(c) && <span class="draft">borrador</span>}
            </h2>
            <p class="blurb" set:html={blurbHtml(c)} />
            <CodigoAction codigo={c} compact />
          </section>
        ))}
        <p class="revisado">Los reviso a mano. Última vez: {fechaLarga(ultimaRevision(codigos))}.</p>
      </>
    )
  }

  <CodigosFooter slot="footer" />
</Base>

<style>
  .intro {
    margin-bottom: 3rem;
  }

  .intro .avatar {
    display: block;
    width: 76px;
    height: 76px;
  }

  .intro h1 {
    margin: 1rem 0 0.5rem;
    color: var(--heading);
    font-size: 2.1rem;
    line-height: 1.15;
  }

  .intro p {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .codigo {
    margin-bottom: 2.25rem;
  }

  .codigo h2 {
    margin: 0 0 0.25rem;
    font-size: 1.35rem;
    line-height: 1.25;
  }

  .codigo h2 a {
    color: var(--heading);
    text-decoration: none;
  }

  .codigo h2 a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .blurb {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.55;
  }

  .blurb :global(strong) {
    color: var(--heading);
  }

  .revisado {
    margin: 3rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid color-mix(in srgb, var(--text) 15%, var(--bg));
    color: var(--muted);
    font-size: 0.95rem;
  }

  .draft {
    margin-left: 0.5rem;
    padding: 0 0.4rem;
    border: 1px dashed var(--muted);
    border-radius: 4px;
    font-size: 0.8rem;
    font-weight: 400;
    vertical-align: middle;
  }

  .empty {
    margin-top: 3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
